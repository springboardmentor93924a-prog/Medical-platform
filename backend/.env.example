# Copy to .env and fill in values. Do not commit .env.
# MySQL/MariaDB connection (hosted or local)
DB_URL=jdbc:mysql://<host>:3306/<database>?sslMode=DISABLED&connectTimeout=15000&socketTimeout=30000
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>

# Base64-encoded random secret, at least 32 bytes (openssl rand -base64 32)
JWT_SECRET=<base64_secret>
