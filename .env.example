# User Registration Approval Settings (Set to true to require Admin approval before login)
PHARMACIST_APPROVAL_REQUIRED=false
STAFF_APPROVAL_REQUIRED=false
SUPPLIER_APPROVAL_REQUIRED=false

# Inventory Expiry Warning Days & Scheduler Settings
