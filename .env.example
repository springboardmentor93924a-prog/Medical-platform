EXPIRY_DAYS_THRESHOLD=30
EXPIRY_AUDIT_CRON=0 0 1 * * ?

# Automatic Database Backup & Recovery Settings
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_CRON=0 0 2 * * ?

# Frontend Configuration
